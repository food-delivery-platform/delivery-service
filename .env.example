# Copy to .env and fill in values for your own sandbox/staging AWS or Supabase project.
# Never commit a real value here — see docs/PLAN.md Phase 9 for how these map to
# GitHub Actions Secrets / AWS Secrets Manager in CI/CD.

AWS_REGION=us-east-1

DYNAMODB_TABLE_DELIVERY_ASSIGNMENTS=delivery_assignments
DYNAMODB_TABLE_COURIER_STATES=courier_states
DYNAMODB_TABLE_ORDER_EVENTS=order_events

SNS_TOPIC_ARN_ORDER_EVENTS=
SQS_QUEUE_URL_DELIVERY_EVENTS=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ORDER_SERVICE_URL=
WAZE_API_KEY=

MAX_COURIER_DISTANCE_MINUTES=15
GPS_SYNC_INTERVAL_SECONDS=600
SQS_POLL_INTERVAL_SECONDS=5

LOG_LEVEL=INFO
ENVIRONMENT=dev
